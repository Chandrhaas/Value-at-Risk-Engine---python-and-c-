# Local dev environments -- never needed inside the image, and none of
# the COPY commands in the Dockerfile reference these anyway (each copies
# a specific named directory rather than the whole repo), but excluding
# them still keeps the build context Docker uploads to the daemon small.
venv/
.venv/
env/

# Python bytecode / cache
__pycache__/
*.pyc
*.pyo

# Version control / editor
.git/
.gitignore
.vscode/
.idea/

# Training-time artifacts, not needed to serve the API (only models/ is
# needed at runtime -- data/ is prepare_data.py's cache, not consumed by
# ml_var.py or api/main.py at all)
data/

# A locally-built extension, if you have one lying around -- the
# Dockerfile builds its own inside the "builder" stage, so a stale local
# build/ shouldn't be relied on or confused with the one that ships
build/

# Misc project files not needed in the image
note.txt
*.md
test.py
.DS_Store